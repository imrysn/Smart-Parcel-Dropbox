# ===== IMPORTANT NOTES =====
# NEVER commit:
# 1. google-services.json - Contains Firebase project credentials
# 2. firebase_options.dart - Contains API keys and project IDs
# 3. local.properties - Contains local SDK paths
# 4. Any .keystore or .jks files - Used for app signing
# 5. Any files with "secret", "key", or "password" in the name
# 6. Project documentation with sensitive information
# 7. Thesis documents or research papers
