# Environment Configuration
PORT=3000
MONGODB_URI=mongodb://localhost:27017/smart_parcel_dropbox
JWT_SECRET=
# JSON mapping each ESP32 MAC address to its own random secret (32+ characters).
SPD_DEVICE_KEYS={}
# Optional Android delivery push. Use Firebase Application Default Credentials.
SPD_PUSH_ENABLED=false
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/firebase-service-account.json
EMAIL_USER=
EMAIL_PASS=

# ESP32-S3 Configuration
ESP32_IP=192.168.1.100
ESP32_PORT=80

# Arduino Scanner Configuration
SCANNER_PORT=COM3
SCANNER_BAUD_RATE=9600
# Optional paired box for the server-attached serial scanner.
SPD_SERIAL_DEVICE_ID=

# CORS Configuration
ALLOWED_ORIGINS=http://localhost:3000,http://10.63.248.0/24
