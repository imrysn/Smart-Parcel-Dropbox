rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    
    // --- Helper Functions ---
    
    // Check if user is authenticated (signed in)
    function isSignedIn() {
      return request.auth != null;
    }

    // Check if user has the 'admin' role
    function isAdmin() {
      // Allows an admin to manage all data
      return isSignedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user is the owner of the resource/data
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // --- Collections ---

    // 1. Users Collection
    // Admin can read/write all user data. Owner can read/write their own data.
    match /users/{userId} {
      // Merged logic: Owner can manage their own data, Admin can manage all.
      allow read, write: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    
    // 2. Tracking IDs Collection
    // Owner can manage their own IDs. Admin can manage all. IoT/system can create/update.
    match /tracking_ids/{trackingId} {
      // Check if the authenticated user is the owner of the specific tracking ID
      function isTrackingOwner() {
        return isOwner(resource.data.userId);
      }
      
      // Check if the user is attempting to set themselves as the owner on creation
      function isRequestingOwner() {
        return isOwner(request.resource.data.userId);
      }
      // Read: Owner or Admin
      allow read: if isTrackingOwner() || isAdmin();
      
      // Create: Owner or Admin (ensuring they set the correct userId)
      allow create: if isRequestingOwner() || isAdmin();
      
      // Update: Owner or Admin (for management), OR any signed-in user (for IoT/delivery status updates)
      allow update: if isTrackingOwner() || isAdmin() || isSignedIn();
      
      // Delete: Admin only
      allow delete: if isAdmin();
    }
    
    // 3. Delivery Logs Collection
    // Owner can read their logs. Admin can read all. IoT/system can create.
    match /delivery_logs/{logId} {
      // Check if the log belongs to the authenticated user
      function isLogOwner() {
        return isOwner(resource.data.userId);
      }
      // Read: Log owner or Admin
      allow read: if isLogOwner() || isAdmin();
      
      // Create: Any signed-in user (for IoT/system write)
      allow create: if isSignedIn();
      
      // Delete: Admin only
      allow delete: if isAdmin();
    }
    
    // 4. Scan Logs Collection
    // Owner can read their logs. Admin can read all. IoT/system can create.
    match /scan_logs/{logId} {
      // Check if the log belongs to the authenticated user OR if userId is null/not set
      function isScanOwner() {
        return isOwner(resource.data.userId) || resource.data.userId == null;
      }
      // Read: Log owner/anonymous scan or Admin
      allow read: if isScanOwner() || isAdmin();
      
      // Create: Any signed-in user (for IoT/system write)
      allow create: if isSignedIn();
      
      // Delete: Admin only
      allow delete: if isAdmin();
    }

    // 5. Notifications Collection
    // Owner can read/update their notifications. Admin can read/update all. System can create.
    match /notifications/{notificationId} {
      // Check if the notification belongs to the authenticated user
      function isNotificationOwner() {
        return isOwner(resource.data.userId);
      }
      
      // Read/Update: Notification owner or Admin
      allow read, update: if isNotificationOwner() || isAdmin();
      
      // Create: Any signed-in user (for IoT/system create)
      allow create: if isSignedIn();
      
      // Delete: Admin only
      allow delete: if isAdmin();
    }

    // 6. Delegates Subcollection (Under /users/{ownerId}/delegates/{delegateId})
    // This allows the Admin user (the owner) to manage who else can access the box.
    match /users/{ownerId}/delegates/{delegateId} {
      // Read: Owner of the user document or Admin
      allow read: if isOwner(ownerId) || isAdmin();
      
      // Write/Update/Delete: Owner of the user document (for adding/removing delegates) or Admin
      allow write, update, delete: if isOwner(ownerId) || isAdmin();
    }

    // 7. Device Control Collection (for IoT drop box control)
    // Any signed-in user can read door state and send commands. Admin can manage all.
    match /device_control/{controlId} {
      // Read: Any signed-in user (to see door state) or Admin
      allow read: if isSignedIn() || isAdmin();
      
      // Write/Update: Any signed-in user (to send open/close commands) or Admin
      allow write, update: if isSignedIn() || isAdmin();
    }
  }
}
